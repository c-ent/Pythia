# Copy to .env and fill in the empty values. .env is gitignored.

# Database password, used by the Postgres container and the server.
# Generate one, e.g. PowerShell: [guid]::NewGuid().ToString('N')
POSTGRES_PASSWORD=

# Server on the host (pnpm dev, pnpm --filter server migrate) talks to the
# compose containers through these 127.0.0.1 ports.
PYTHIA_DB_HOST=127.0.0.1
PYTHIA_DB_PORT=5433
PYTHIA_DB_USER=pythia
PYTHIA_DB_NAME=pythia
PYTHIA_OLLAMA_PORT=11434
OLLAMA_URL=http://127.0.0.1:11434
PORT=3000

# Indexing embeds (vault, repos, Keep): chunks per Ollama request and the wait
# per request. Defaults suit a multi-core host; on a 1-core VM use smaller
# batches and a longer timeout, e.g. 8 and 600000. Search is not affected.
PYTHIA_EMBED_BATCH_SIZE=32
PYTHIA_EMBED_TIMEOUT_MS=120000

# Set to 1 to run the Postgres integration tests (needs the postgres container).
PYTHIA_DB_TESTS=0

# Set to 1 to run the live Ollama embedding smoke test (needs the ollama
# container with nomic-embed-text pulled).
PYTHIA_OLLAMA_TESTS=0

# Obsidian vault (T6). Absolute path to a read-only copy of the vault; leave
# empty to run without vault indexing. Folders and notes to keep away from
# Gemini are set in the app under Settings (stored in the database, empty by
# default); frontmatter `llm: false` also keeps a note away.
PYTHIA_VAULT_PATH=
# 1 watches the vault for changes after the startup scan; 0 scans once.
PYTHIA_VAULT_WATCH=1

# Repos (T15). Path to a JSON file listing the repos to mirror, e.g.
#   { "repos": [ { "name": "kitchen-app", "url": "https://github.com/OWNER/kitchen-app.git" } ] }
# Optional per repo: "branch" (default: the remote's default branch) and
# "enabled": false. Empty turns repo fetching off.
PYTHIA_REPOS_CONFIG=
# Bare mirrors live here, one <name>.git per repo.
PYTHIA_REPOS_DIR=data/repos
PYTHIA_REPOS_FETCH_MINUTES=30
# Fine-grained, read-only (Contents: read) token for private github.com
# repos. Never put it in a repo URL. Empty works for public repos.
GITHUB_TOKEN=

# Auth (T8). Generate all three with: pnpm --filter server auth-env
# (prompts for the password and never prints it). Keep the single quotes
# around the hash: it contains $. Empty keeps web login and /mcp closed.
PYTHIA_PASSWORD_HASH=
# Signs session cookies; empty means sessions end on every restart.
PYTHIA_SESSION_SECRET=
# Bearer token for /mcp (T12), separate from the web login.
PYTHIA_MCP_TOKEN=

# Ask (T13). Without a key, Ask uses the local model or returns passages only.
# Notes with allow_llm = false are never sent to Gemini either way.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Local answer model in the ollama container (pull it first:
# docker compose exec ollama ollama pull qwen3:4b). Empty turns it off.
OLLAMA_CHAT_MODEL=qwen3:4b

# Built web app served by the server (T18). The compose app service sets
# /app/web itself; leave this commented out (an empty value in .env would
# reach the container and turn the web app off). In dev, Vite serves it.
# PYTHIA_WEB_DIR=

# Always-on host only (docker-compose.prod.yml, T18).
# Remote path for the one-way rclone pull; rclone.conf goes in data/rclone/.
# PYTHIA_RCLONE_SOURCE=dropbox:Apps/remotely-save/<vault name>
# PYTHIA_RCLONE_INTERVAL_SECONDS=300
# PYTHIA_HOST_VAULT_DIR=./data/vault
# PYTHIA_HOST_CONFIG_DIR=./data/config
